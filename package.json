{
  "name": "action-get-release-workspace",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "./action-get-release",
      "./action"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.8.1",
  "scripts": {
    "check": "turbo run check",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "update": "ncu -ws -i"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  }
}
